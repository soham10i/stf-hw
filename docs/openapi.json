  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "type": "array",
            "maxItems": 8,
            "title": "History"
          },
          "grounding": {
            "$ref": "#/components/schemas/Grounding"
          },
          "page": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[a-z0-9-]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(gemini|groq|grok|upb|openai|ollama|rules|auto)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "age": {
            "type": "number",
            "maximum": 2000.0,
            "minimum": 0.0,
            "title": "Age",
            "default": 140.0
          },
          "pm": {
            "type": "boolean",
            "title": "Pm",
            "default": true
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "user": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{8,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "User"
          },
          "mode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(auto|docs|web|deep)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "depth": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(auto|brief|standard|thorough)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Depth"
          },
          "audience": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(operator|engineer|researcher)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audience"
          },
          "sources": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(vetted|strict)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest",
        "description": "The copilot's input contract: question plus everything that steers the answer\n(provider ladder, route mode, depth, audience, source policy, session identity)."
      },
      "CommandRequest": {
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "retrieve",
              "store",
              "home",
              "cycle"
            ],
            "title": "Op"
          },
          "slot": {
