# only web/, packages/, services/ and the copilot's guides (docs/reference) go into the image
.git
.github
.venv
.cache
**/__pycache__
**/*.pyc
**/node_modules
web/dist
web/dist-pages
web/tsconfig.tsbuildinfo
stf-cad
docs/*
!docs/reference
tests
mosquitto
utils
# anchored like .gcloudignore: an unanchored *.md can match at ANY depth (gitignore semantics
# on Cloud Build's docker builder) and would eat web/public/copilot/docs/**.md - the dashboard
# Docs page's documents.
/*.md
!docs/reference/**/*.md
.env
.env.*
.data
web/public/legal/imprint.html
