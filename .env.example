# Copy to .env (never commit .env) and set real values.
POSTGRES_USER=stf
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# API: browser origins allowed to call it, and the operator token for remote commands (empty = localhost only)
STF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
STF_API_TOKEN=
# The dashboard chat (services/api/chat.py): a Gemini API key from Google AI Studio. Empty = the chat
# answers offline. The key stays on the server; the browser never sees it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_LIMIT=300
