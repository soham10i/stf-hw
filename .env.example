# Copy to .env (never commit .env) and set real values.
POSTGRES_USER=stf
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# API: browser origins allowed to call it, and the operator token for remote commands (empty = localhost only)
STF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
STF_API_TOKEN=
# The dashboard chat (services/api/chat.py): a Gemini API key from Google AI Studio.
# Get one at https://aistudio.google.com/apikey — empty = the chat answers offline.
# The key stays on the server; the browser never sees it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_DAILY_LIMIT=300

# Optional offline LLM (services/api/chat.py): local Ollama instance
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# The copilot's sessions and spoken answers (services/api/store.py, sessions.py, tts.py).
# STF_DATA_DIR: where session JSON documents live (default <repo>/.data, git-excluded).
STF_DATA_DIR=
# Gemini fallback order: when one model hits its limit the next answers (chat + TTS + STT pools).
GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_TTS_MODELS=gemini-2.5-pro-preview-tts,gemini-2.5-flash-preview-tts,gemini-3.8-flash-tts
GEMINI_STT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash
GEMINI_TTS_DAILY_LIMIT=100
# Spoken-answer provider order: elevenlabs first when its key is set, gemini next, the OS voice last.
TTS_PROVIDERS=elevenlabs,gemini,local
# ElevenLabs (the portfolio site's voice; empty = skipped): https://elevenlabs.io/api
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2


# Inspection-camera photos (services/api/captures.py, docs/CAPTURES.md). Without Supabase they are
# kept on the server's disk under STF_DATA_DIR/captures (lost on Render at each deploy).
STF_CAPTURES=1
STF_CAPTURE_DAILY=500
STF_CAPTURE_KEEP=2000
# Supabase (free tier): a private Storage bucket for the JPEGs + a `captures` table. The SERVICE
# key stays on the server - never in the browser or in git.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=captures
