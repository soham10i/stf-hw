# Copy to .env (never commit .env) and set real values.
POSTGRES_USER=stf
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# API: browser origins allowed to call it, and the operator token for remote commands (empty = localhost only)
STF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
STF_API_TOKEN=
STF_LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
# The dashboard chat (services/api/chat.py): a Gemini API key from Google AI Studio.
# Get one at https://aistudio.google.com/apikey — empty = the chat answers offline.
# The key stays on the server; the browser never sees it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_DAILY_LIMIT=300

# Optional Groq LPU acceleration (services/api/chat.py, tts.py): ultra-fast LLM, Whisper STT, and TTS.
# Get an API key at https://console.groq.com/keys — empty = skipped.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional offline LLM (services/api/chat.py): local Ollama instance
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# The copilot's sessions and spoken answers (services/api/store.py, sessions.py, tts.py).
# STF_DATA_DIR: where session JSON documents live (default <repo>/.data, git-excluded).
STF_DATA_DIR=
# Gemini fallback order: when one model hits its limit the next answers (chat + TTS + STT pools).
GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_TTS_MODELS=gemini-2.5-pro-preview-tts,gemini-2.5-flash-preview-tts,gemini-3.8-flash-tts
GEMINI_STT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash
GEMINI_TTS_DAILY_LIMIT=100
# Spoken-answer provider order: elevenlabs first when its key is set, groq next, gemini next, OS voice last.
TTS_PROVIDERS=elevenlabs,groq,gemini,local
# ElevenLabs (the portfolio site's voice; empty = skipped): https://elevenlabs.io/api
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2


# Inspection-camera photos (services/api/captures.py, docs/CAPTURES.md). Without Supabase they are
# kept on the server's disk under STF_DATA_DIR/captures (lost on Render at each deploy).
STF_CAPTURES=1
STF_CAPTURE_DAILY=500
STF_CAPTURE_KEEP=2000
# Usage traction, consent-gated (services/api/visits.py): a beacon per page visit is stored
# only after the visitor accepts the banner. The row is the anonymous guest session id, the
# page, the time, the IP and its coarse place (never an exact location; a "no" stores nothing).
STF_TRACKING=1     # 0: the beacon is answered with 204, nothing is stored
STF_GEO=1          # 0: the IP is stored without the country/region/city lookup
STF_TRACK_DAYS=180 # how long the consent cookie is kept
# Supabase (free tier): a private Storage bucket for JPEGs + Postgres tables (docs/DATABASE.md, CAPTURES.md).
# The SECRET/SERVICE key stays on the server — never in the browser or in git.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=captures
SUPABASE_DATABASE_PASSWORD=

# University Paderborn AI Chat (Open WebUI)
# UPB_AI_URL=https://ai-chat.uni-paderborn.de
# UPB_AI_KEY=

# Your own open model, served OpenAI-compatible (vLLM / Ollama / text-embeddings-inference on
# Azure Container Apps or Cloud Run - kimi-code/OPEN_LLM_DEPLOY.md). The copilot tries it after
# the cloud providers, before the tiny local Ollama model.
# OPENAI_URL=https://your-host/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# Document retrieval (services/api/vectors.py): BM25 fused with passage embeddings.
# STF_EMBEDDER=auto            # auto | hash | minilm | http | off
# STF_EMBED_MODEL=             # a sentence-transformers name, for minilm
# EMBEDDINGS_URL=              # OpenAI-compatible /v1/embeddings endpoint, for http
# EMBEDDINGS_KEY=
# EMBEDDINGS_MODEL=

# Owner visitor notifications (services/api/notify.py): emails owner when a visitor accepts consent banner
# STF_NOTIFY_EMAIL=you@gmail.com
# STF_SMTP_HOST=smtp.gmail.com
# STF_SMTP_PORT=465
# STF_SMTP_USER=you@gmail.com
# STF_SMTP_PASS=xxxx xxxx xxxx xxxx   # Gmail 16-character App Password (from myaccount.google.com/apppasswords)
