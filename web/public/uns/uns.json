st-topic-phid-birth-payload-timestamp","checked":2,"ok":true,"first_violation":null,"text":"The timestamp metric value MUST be the same timestamp value set in the immediately prior MQTT CONNECT packet's Will Message payload."},{"id":"host-topic-phid-birth-qos","checked":3,"ok":true,"first_violation":null,"text":"The MQTT Quality of Service (QoS) MUST be set to 1"},{"id":"host-topic-phid-birth-retain","checked":3,"ok":true,"first_violation":null,"text":"The MQTT retain flag for the Birth Certificate MUST be set to TRUE"},{"id":"host-topic-phid-death-payload","checked":2,"ok":true,"first_violation":null,"text":"The STATE Death Certificate Payload MUST be JSON UTF-8 data. It MUST include two key/value pairs where one key MUST be 'online' and it's value is a boolean 'false'. The other key MUST be 'timestamp' and the value MUST be a numeric value representing the current UTC time in milliseconds since Epoch."},{"id":"host-topic-phid-death-qos","checked":2,"ok":true,"first_violation":null,"text":"The MQTT Quality of Service (QoS) MUST be set to 1"},{"id":"host-topic-phid-death-retain","checked":2,"ok":true,"first_violation":null,"text":"The MQTT retain flag for the Birth Certificate MUST be set to TRUE"},{"id":"message-flow-device-birth-publish-nbirth-wait","checked":16,"ok":true,"first_violation":null,"text":"The NBIRTH message MUST have been sent within the current MQTT session prior to a DBIRTH being published."},{"id":"message-flow-edge-node-birth-publish-nbirth-payload","checked":4,"ok":true,"first_violation":null,"text":"The Edge Node's NBIRTH payload MUST be a Sparkplug Google Protobuf encoded payload."},{"id":"message-flow-edge-node-birth-publish-will-message-qos","checked":3,"ok":true,"first_violation":null,"text":"The Edge Node's MQTT Will Message's MQTT QoS MUST be 1."},{"id":"message-flow-edge-node-birth-publish-will-message-will-retained","checked":3,"ok":true,"first_violation":null,"text":"The Edge Node's MQTT Will Message's retained flag MUST be set to false."},{"id":"operational-behavior-data-commands-ncmd-rebirth-value","checked":1,"ok":true,"first_violation":null,"text":"A Rebirth Request MUST include a metric value of true."},{"id":"operational-behavior-data-commands-ncmd-rebirth-verb","checked":1,"ok":true,"first_violation":null,"text":"A Rebirth Request MUST use the NCMD Sparkplug verb."},{"id":"operational-behavior-data-commands-rebirth-action-2","checked":1,"ok":true,"first_violation":null,"text":"After an Edge Node stops sending DATA messages, it MUST send a complete BIRTH sequence including the NBIRTH and DBIRTH(s) if applicable."},{"id":"operational-behavior-data-commands-rebirth-action-3","checked":1,"ok":true,"first_violation":null,"text":"The NBIRTH MUST include the same bdSeq metric with the same value it had included in the Will Message of the previous MQTT CONNECT packet."},{"id":"operational-behavior-data-commands-rebirth-name-aliases","checked":4,"ok":true,"first_violation":null,"text":"When aliases are being used by an Edge Node an NBIRTH message MUST NOT include an alias for the 'Node Control/Rebirth' metric."},{"id":"operational-behavior-data-publish-nbirth-change","checked":8022,"ok":true,"first_violation":null,"text":"NDATA messages SHOULD only be published when Edge Node level metrics change."},{"id":"operational-behavior-edge-node-birth-sequence-wait","checked":4,"ok":true,"first_violation":null,"text":"The Edge Node MUST also wait to publish its BIRTH sequence until an online=true STATE message is received by the Edge Node."},{"id":"operational-behavior-primary-application-state-with-multiple-servers-walk","checked":1,"ok":true,"first_violation":null,"text":"If the Primary Host Application is offline as denoted via the STATE MQTT Message, the Edge Node MUST terminate its session with this MQTT Server and move to the next available MQTT Server that is available."},{"id":"payloads-alias-birth-requirement","checked":516,"ok":true,"first_violation":null,"text":"NBIRTH and DBIRTH messages MUST include both a metric name and alias."},{"id":"payloads-alias-data-cmd-requirement","checked":7047,"ok":true,"first_violation":null,"text":"NDATA, DDATA, NCMD, and DCMD messages MUST only include an alias and the metric name MUST be excluded."},{"id":"payloads-alias-uniqueness","checked":516,"ok":true,"first_violation":null,"text":"If supplied in an NBIRTH or DBIRTH it MUST be a unique number across this Edge Node's entire set of metrics."},{"id":"payloads-name-birth-data-requirement","checked":7067,"ok":true,"first_violation":null,"text":"The timestamp MUST be included with every metric in all NBIRTH, DBIRTH, NDATA, and DDATA messages."},{"id":"payloads-sequence-num-always-included","checked":7067,"ok":true,"first_violation":null,"text":"A sequence number MUST be included in the payload of every Sparkplug MQTT message from an Edge Node except NDEATH messages."},{"id":"payloads-sequence-num-incrementing","checked":7063,"ok":true,"first_violation":null,"text":"All subsequent messages after an NBIRTH from an Edge Node MUST contain a sequence number that is continually increasing by one in each message from that Edge Node until a value of 255 is reached. At that point, the sequence number of the following message MUST be zero."},{"id":"stf-ddata-device-born","checked":3049,"ok":true,"first_violation":null,"text":"A DDATA is published only for a device that has a DBIRTH in the current session."},{"id":"stf-payload-decodes","checked":7068,"ok":true,"first_violation":null,"text":"Every Sparkplug message decodes with the Sparkplug B schema (sparkplug_b.proto)."},{"id":"topic-structure-namespace-device-id-associated-message-types","checked":3065,"ok":true,"first_violation":null,"text":"The device_id MUST be included with message_type elements DBIRTH, DDEATH, DDATA, and DCMD based topics."},{"id":"topic-structure-namespace-device-id-non-associated-message-types","checked":4007,"ok":true,"first_violation":null,"text":"The device_id MUST NOT be included with message_type elements NBIRTH, NDEATH, NDATA, NCMD, and STATE based topics"},{"id":"topics-dbirth-metric-reqs","checked":7541,"ok":true,"first_violation":null,"text":"The DBIRTH MUST include every metric the Edge Node will ever report on."},{"id":"topics-dbirth-metrics","checked":472,"ok":true,"first_violation":null,"text":"At a minimum each metric MUST include the metric name, metric datatype, and current value."},{"id":"topics-dbirth-mqtt","checked":16,"ok":true,"first_violation":null,"text":"DBIRTH messages MUST be published with MQTT QoS equal to 0 and retain equal to false."},{"id":"topics-dbirth-timestamp","checked":16,"ok":true,"first_violation":null,"text":"The DBIRTH MUST include a timestamp denoting the date and time the message was sent from the Edge Node."},{"id":"topics-ddata-mqtt","checked":3049,"ok":true,"first_violation":null,"text":"DDATA messages MUST be published with MQTT QoS equal to 0 and retain equal to false."},{"id":"topics-ddata-payload","checked":7541,"ok":true,"first_violation":null,"text":"The DDATA MUST include the Device\u2019s metrics that have changed since the last DBIRTH or DDATA message."},{"id":"topics-ddata-timestamp","checked":3049,"ok":true,"first_violation":null,"text":"The DDATA MUST include a timestamp denoting the date and time the message was sent from the Edge Node."},{"id":"topics-nbirth-bdseq-included","checked":4,"ok":true,"first_violation":null,"text":"A bdSeq number as a metric MUST be included in the payload."},{"id":"topics-nbirth-bdseq-increment","checked":2,"ok":true,"first_violation":null,"text":"The bdSeq number MUST start at zero and increment by one on every new MQTT CONNECT packet."},{"id":"topics-nbirth-bdseq-matching","checked":3,"ok":true,"first_violation":null,"text":"This MUST match the bdSeq number provided in the MQTT CONNECT packet\u2019s Will Message payload."},{"id":"topics-nbirth-metric-reqs","checked":8022,"ok":true,"first_violation":null,"text":"The NBIRTH MUST include every metric the Edge Node will ever report on