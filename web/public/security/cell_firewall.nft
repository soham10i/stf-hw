# cell firewall - generated by stf-cad/hbw/security.py from the program and the register map
table inet stf {
  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related accept
    # C1 PLC -> the four I/O nodes (Modbus TCP 502; none on the wire: the nodes cannot; enforced by the cell switch (port lock, static ARP) and the DPI allow-list)
    # C2 HMI -> PLC (HMI tag set); historian <- PLC (subscription) (OPC UA 4840; SignAndEncrypt, X.509 per client, user roles (operator, maintenance, security))
    # C3 EMS -> inverter (SunSpec Modbus TCP 502; none on the wire: DPI register allow-list; the reserve is a local setting)
    # C4 historian -> dashboard (push only) (HTTPS 443; mutual TLS; outbound from Z2 only - nothing in the DMZ can open a connection inward)
    # C5 OpenADR VEN <-> utility VTN (VEN polls out) (OpenADR 2.0b over HTTPS 443; mutual TLS, the VTN's certificate pinned)
    # C6 OpenADR VEN -> EMS (events) (MQTT over TLS 8883; client certificate; events checked against the EMS limits)
    # C7 vendor / engineer -> jump host (HTTPS 443 (RDP gateway); MFA, time-limited, session recorded, approved per session)
    # C8 jump host -> PLC (program download, diagnostics) (SSH 22 / OPC UA 4840; maintenance key switch on the cabinet enables the port; signed programs only)
    ip saddr 192.168.10.10 ip daddr { 192.168.10.11, 192.168.10.12, 192.168.10.13, 192.168.10.14 } tcp dport 502 queue num 1   # C1 -> Modbus DPI
    ip saddr @z2_hmi ip daddr 192.168.10.10 tcp dport 4840 accept                # C2
    ip saddr @z2_ems ip daddr @z3_inverter tcp dport 502 queue num 2              # C3 -> SunSpec DPI
    ip saddr @z2_hist ip daddr @z4_dash tcp dport 443 accept                      # C4 push only
    ip saddr @z4_ven ip daddr @z2_ems tcp dport 8883 accept                       # C6
    ip saddr @z4_jump ip daddr 192.168.10.10 tcp dport { 22, 4840 } meta mark 0x1 accept   # C8, key switch sets mark
    log prefix "SEC-04 " drop
  }
}

# Modbus DPI (queue 1): allow exactly these, drop the rest
# 192.168.10.11   FC15 write_coils  addr   0 count  8   (hbw)
# 192.168.10.11   FC1  read_coils   addr   0 count  8   (hbw)
# 192.168.10.11   FC2  read_di      addr   0 count  4   (hbw)
# 192.168.10.11   FC2  read_di      addr   6 count  2   (hbw)
# 192.168.10.11   FC4  read_ir      addr 100 count  4   (hbw)
# 192.168.10.11   FC3  read_hr      addr   0 count 16   (hbw)
# 192.168.10.12   FC15 write_coils  addr   0 count  6   (vgr)
# 192.168.10.12   FC15 write_coils  addr   7 count  1   (vgr)
# 192.168.10.12   FC1  read_coils   addr   0 count  6   (vgr)
# 192.168.10.12   FC1  read_coils   addr   7 count  1   (vgr)
# 192.168.10.12   FC2  read_di      addr   0 count  5   (vgr)
# 192.168.10.12   FC4  read_ir      addr 100 count  6   (vgr)
# 192.168.10.13   FC15 write_coils  addr   0 count  9   (oven)
# 192.168.10.13   FC15 write_coils  addr  10 count  4   (oven)
# 192.168.10.13   FC1  read_coils   addr   0 count  9   (oven)
# 192.168.10.13   FC1  read_coils   addr  10 count  4   (oven)
# 192.168.10.13   FC2  read_di      addr   0 count  8   (oven)
# 192.168.10.13   FC2  read_di      addr   9 count  6   (oven)
# 192.168.10.14   FC15 write_coils  addr   0 count  1   (sorting)
# 192.168.10.14   FC15 write_coils  addr   2 count  3   (sorting)
# 192.168.10.14   FC1  read_coils   addr   0 count  1   (sorting)
# 192.168.10.14   FC1  read_coils   addr   2 count  3   (sorting)
# 192.168.10.14   FC2  read_di      addr   0 count  1   (sorting)
# 192.168.10.14   FC2  read_di      addr   2 count  4   (sorting)
# 192.168.10.14   FC4  read_ir      addr   0 count  1   (sorting)
