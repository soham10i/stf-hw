{
 "variant": "up12",
 "compiler": "MatIEC iec2c matiec version 0.1",
 "wasm_sha": "eeaa28595da0e2bf",
 "st_lines": 1929,
 "scan_ms": 5,
 "u4": {
  "accepted": false,
  "errors": 910,
  "first": "u4.st:26: error: invalid located variable declaration."
 },
 "findings": [
  {
   "id": "F1",
   "kind": "compile",
   "text": "The U4 program used `Step` as a variable, a reserved word of IEC 61131-3: MatIEC rejected it."
  },
  {
   "id": "F2",
   "kind": "compile",
   "text": "Every positioning step waited for one undeclared `Target[Arg]`; each step needs its own target."
  },
  {
   "id": "F3",
   "kind": "logic",
   "text": "`Done` was set and never cleared, so the orchestrator could not see a unit's second job end."
  },
  {
   "id": "F4",
   "kind": "logic",
   "text": "The orchestrator (MAIN) existed only as comments."
  },
  {
   "id": "F5",
   "kind": "logic",
   "text": "A multi-axis VGR move drove every axis until the step ended: the axes that arrived first overran."
  },
  {
   "id": "F6",
   "kind": "compile",
   "text": "Several step conditions were prose (RF2.tag = record, count(I1) = N_eject, I5 broken)."
  },
  {
   "id": "F7",
   "kind": "run",
   "text": "Homing left the crane's lift at its bottom reference switch; every job starts at transit height."
  },
  {
   "id": "F8",
   "kind": "run",
   "text": "The oven door (single-acting) fell shut on the extended Ofenschieber between U10's present and place."
  },
  {
   "id": "F9",
   "kind": "run",
   "text": "The Drehtisch's 180 degree return had the time of a 90 degree turn: its watchdog tripped."
  },
  {
   "id": "F10",
   "kind": "run",
   "text": "Watchdogs were the same for every binding: the run to the blue ejector (8 s) was watched as 2.4 s."
  }
 ],
