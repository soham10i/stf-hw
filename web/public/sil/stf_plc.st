(* every scan: outputs off unless the active state sets them; Done is a pulse *)
Q3 := FALSE; Q4 := FALSE; Q5 := FALSE; Q6 := FALSE; Q7 := FALSE; Q8 := FALSE; Done := FALSE;
IF NOT Enable AND Sn <> 900 THEN Sn := 900; END_IF;
Wd(IN := (Sn = Prev) AND (WdTime > T#0MS), PT := WdTime);
Tm(IN := (Sn = Prev), PT := T#1H);
Prev := Sn;
IF Wd.Q THEN Alarm := Sn; Sn := 910; END_IF;

CASE Sn OF
  0: (* INIT: power-up, all outputs off *)
      WdTime := T#0MS; IF Enable THEN Sn := 10; END_IF;
  10: (* H:fork: Ausleger back to its rear stop *)
      WdTime := T#1700MS;
      Q8 := TRUE;
      IF I6 THEN Sn := 11; END_IF;
  11: (* H:lift: lift to the reference switch (direction ASSUMED: down) *)
      WdTime := T#3300MS;
      Q5 := TRUE;
      IF I4 THEN Sn := 12; END_IF;
  12: (* H:travel: travel to the reference switch (direction ASSUMED: to the belt) *)
      WdTime := T#6000MS;
      Q4 := TRUE;
      IF I1 THEN Sn := 13; END_IF;
  13: (* H:transit: lift to transit height (the pose every job starts from) *)
      WdTime := T#3100MS;
      CASE Drive(PosLift, 260.0, 0.375) OF -1: Q5 := TRUE; 1: Q6 := TRUE; END_CASE;
      IF ABS(PosLift - 260.0) <= 1.0 THEN Sn := 100; END_IF;
  100: (* READY: homed, waiting for a job *)
      WdTime := T#0MS; Ready := TRUE; Busy := FALSE;
      IF Cmd <> 0 THEN Job := Cmd; B1 := Arg1; Busy := TRUE; Ready := FALSE;
          CASE Cmd OF 11: Sn := 1000; 13: Sn := 2000; 14: Sn := 3000; 15: Sn := 4000; ELSE Sn := 910; Alarm := -Cmd; END_CASE;
      END_IF;
  1000: (* store_retrieve.01 lift->80: lift to 80 *)
      WdTime := T#2300MS;
