                    UBusy[8] := TRUE;
                    RJ[8] := 1; Seg[8] := 8; Nst[8] := Nst[8] + 1;
                    RB[8, 1] := Inlet; RB[8, 2] := b; RB[8, 3] := 0; RB[8, 4] := 0; RB[8, 5] := 0; RB[8, 6] := 0;
                    Cmd[8] := 1; Arg[8] := b;
                    LvSin := TRUE; ResBay[b] := ResBay[b] + 1;
                    Started := TRUE;
                END_IF;
            END_IF;
            (* 2 oven belt -> sorting inlet *)
            IF NOT Started AND Ovb <> 0 AND NOT LvOvb AND NOT ResSin AND Inlet = 0 AND NOT UBusy[7] THEN
                (* start ovenbelt *)
                UBusy[7] := TRUE;
                RJ[7] := 2; Seg[7] := 7; Nst[7] := Nst[7] + 1;
                RB[7, 1] := Ovb; RB[7, 2] := 0; RB[7, 3] := 0; RB[7, 4] := 0; RB[7, 5] := 0; RB[7, 6] := 0;
                Cmd[7] := 2; Arg[7] := 1;
                LvOvb := TRUE; ResSin := TRUE;
                Started := TRUE;
            END_IF;
            (* 3 saw and eject *)
            IF NOT Started AND Tt <> 0 AND NOT LvTt AND Stage[Tt] = 5 AND NOT ResOvb AND Ovb = 0 AND NOT UBusy[6] THEN
                (* start saw_eject *)
                UBusy[6] := TRUE;
                RJ[6] := 3; Seg[6] := 6; Nst[6] := Nst[6] + 1;
                RB[6, 1] := Tt; RB[6, 2] := 0; RB[6, 3] := 0; RB[6, 4] := 0; RB[6, 5] := 0; RB[6, 6] := 0;
                Cmd[6] := 3; Arg[6] := 1;
                LvTt := TRUE; ResOvb := TRUE;
                Started := TRUE;
            END_IF;
            (* 4 Sauger: tray -> turntable *)
            IF NOT Started AND Tray <> 0 AND NOT LvTray AND Stage[Tray] = 5 AND NOT ResTt AND Tt = 0 AND NOT UBusy[5] AND NOT UBusy[4] THEN
                (* start to_tt *)
                UBusy[5] := TRUE; UBusy[4] := TRUE;
                RJ[5] := 4; Seg[5] := 5; Nst[5] := Nst[5] + 1;
                RB[5, 1] := Tray; RB[5, 2] := 0; RB[5, 3] := 0; RB[5, 4] := 0; RB[5, 5] := 0; RB[5, 6] := 0;
                Cmd[5] := 4; Arg[5] := 1;
                LvTray := TRUE; ResTt := TRUE;
                Started := TRUE;
            END_IF;
            (* 5 bake *)
            IF NOT Started AND Tray <> 0 AND NOT LvTray AND Stage[Tray] = 1 AND NOT UBusy[4] THEN
                (* start bake *)
                UBusy[4] := TRUE;
                RJ[4] := 5; Seg[4] := 4; Nst[4] := Nst[4] + 1;
                RB[4, 1] := Tray; RB[4, 2] := 0; RB[4, 3] := 0; RB[4, 4] := 0; RB[4, 5] := 0; RB[4, 6] := 0;
                Cmd[4] := 5; Arg[4] := 1;
                LvTray := TRUE;
                Started := TRUE;
            END_IF;
            (* 5a the oven presents its tray while the cookie for it is on its way *)
            IF NOT Started AND Tray = 0 AND NOT Tout AND (CupC <> 0 OR ResTray) AND NOT LvTray AND NOT UBusy[4] THEN
                (* start present *)
                UBusy[4] := TRUE;
                RJ[4] := 6; Seg[4] := 4; Nst[4] := Nst[4] + 1;
                RB[4, 1] := CupC; RB[4, 2] := 0; RB[4, 3] := 0; RB[4, 4] := 0; RB[4, 5] := 0; RB[4, 6] := 0;
                Cmd[4] := 6; Arg[4] := 1;
                Started := TRUE;
            END_IF;
            (* 5b the VGR lays the cookie on the presented tray *)
            IF NOT Started AND CupC <> 0 AND Tout AND Tray = 0 AND NOT UBusy[3] AND NOT UBusy[4] THEN
                (* start place_oven *)
                UBusy[3] := TRUE; UBusy[4] := TRUE;
                RJ[3] := 7; Seg[3] := 3; Nst[3] := Nst[3] + 1;
                RB[3, 1] := CupC; RB[3, 2] := CupSrc; RB[3, 3] := 0; RB[3, 4] := 0; RB[3, 5] := 0; RB[3, 6] := 0;
                Cmd[3] := 7; Arg[3] := 1;
                Started := TRUE;
            END_IF;
            (* 7 belt -> oven (the pick half): the oven is free of a committed cookie, the cup is empty *)
            IF NOT Started AND BoutM <> 0 AND BoutC <> 0 AND BoutMode = 1 AND NOT LvBout AND CupC = 0 AND NOT ResTray AND NOT UBusy[3] AND NOT UBusy[2] THEN
                (* start belt_to_oven *)
                UBusy[3] := TRUE; UBusy[2] := TRUE;
                RJ[3] := 8; Seg[3] := 3; Nst[3] := Nst[3] + 1;
                RB[3, 1] := BoutC; RB[3, 2] := BoutM; RB[3, 3] := 0; RB[3, 4] := 0; RB[3, 5] := 0; RB[3, 6] := 0;
                Cmd[3] := 8; Arg[3] := 1;
                LvBout := TRUE; ResTray := TRUE;
                Started := TRUE;
            END_IF;
            (* 9 bay -> the empty mould at the hand-over (the first bay holding a cookie that goes in) *)
            IF NOT Started AND BoutM <> 0 AND BoutC = 0 AND BoutMode = 2 AND NOT LvBout AND CupC = 0 THEN
                Found := FALSE;
                FOR i := 1 TO 3 DO
                    IF NOT Found THEN
                        FOR j := 1 TO BayN[i] DO
                            IF NOT Found AND Stage[Bay[i, j]] = 2 THEN Found := TRUE; c := Bay[i, j]; b := i; END_IF;
                        END_FOR;
                    END_IF;
                END_FOR;
                IF Found AND NOT UBusy[3] AND NOT UBusy[2] THEN
                    (* start bay_to_belt *)
                    UBusy[3] := TRUE; UBusy[2] := TRUE;
                    RJ[3] := 9; Seg[3] := 3; Nst[3] := Nst[3] + 1;
                    RB[3, 1] := c; RB[3, 2] := b; RB[3, 3] := BoutM; RB[3, 4] := 0; RB[3, 5] := 0; RB[3, 6] := 0;
                    Cmd[3] := 9; Arg[3] := b;
                    LvBay[b] := TRUE;
                    Started := TRUE;
                END_IF;
            END_IF;
            (* 10 belt back *)
            IF NOT Started AND BoutM <> 0 AND BoutMode = 3 AND NOT LvBout AND NOT ResBin AND BinM = 0 AND NOT UBusy[2] THEN
                (* start belt_back *)
                UBusy[2] := TRUE;
                RJ[2] := 10; Seg[2] := 2; Nst[2] := Nst[2] + 1;
                RB[2, 1] := BoutM; RB[2, 2] := BoutC; RB[2, 3] := 0; RB[2, 4] := 0; RB[2, 5] := 0; RB[2, 6] := 0;
                Cmd[2] := 10; Arg[2] := 1;
                LvBout := TRUE; ResBin := TRUE; BeltTag := BoutM;
                Started := TRUE;
            END_IF;
            (* the next cookie of the production order that is still raw in the rack, and its slot *)
            tm := 0; ts := 0;
            FOR i := 1 TO 9 DO
                IF tm = 0 AND Stage[PROD[i]] = 1 THEN
                    FOR j := 1 TO 12 DO IF SlotM[j] <> 0 AND SlotC[j] = PROD[i] THEN tm := PROD[i]; ts := j; END_IF; END_FOR;
                END_IF;
            END_FOR;
            (* 10a dual command: store the mould coming in in the free slot nearest the next cookie, retrieve that cookie *)
            IF NOT Started AND BinM <> 0 AND BinMode = 3 AND NOT LvBin AND tm <> 0 AND NOT ResBout AND BoutM = 0 THEN
                n := 0; BestT := 1.0E9;
                FOR i := 1 TO 12 DO
                    IF NOT ResSlot[i] AND SlotM[i] = 0 THEN
                        IF DUALT[i, ts] < BestT THEN BestT := DUALT[i, ts]; n := i; END_IF;
                    END_IF;
                END_FOR;
                IF n <> 0 AND NOT LvSlot[ts] AND NOT UBusy[1] AND NOT UBusy[2] THEN
                    (* start store_retrieve *)
                    UBusy[1] := TRUE; UBusy[2] := TRUE;
                    RJ[1] := 11; Seg[1] := 1; Nst[1] := Nst[1] + 1;
                    RB[1, 1] := BinM; RB[1, 2] := BinC; RB[1, 3] := n; RB[1, 4] := tm; RB[1, 5] := SlotM[ts]; RB[1, 6] := ts;
                    Cmd[1] := 11; Arg[1] := (n - 1) * 12 + ts;
                    LvBin := TRUE; LvSlot[ts] := TRUE; ResSlot[n] := TRUE; ResBin := TRUE;
                    Started := TRUE;
                END_IF;
            END_IF;
            (* 11 belt forward *)
            IF NOT Started AND BinM <> 0 AND (BinMode = 1 OR BinMode = 2) AND NOT LvBin AND NOT ResBout AND BoutM = 0 AND NOT UBusy[2] THEN
                (* start belt_fwd *)
                UBusy[2] := TRUE;
                RJ[2] := 12; Seg[2] := 2; Nst[2] := Nst[2] + 1;
                RB[2, 1] := BinM; RB[2, 2] := BinC; RB[2, 3] := 0; RB[2, 4] := 0; RB[2, 5] := 0; RB[2, 6] := 0;
                Cmd[2] := 12; Arg[2] := 1;
                LvBin := TRUE; ResBout := TRUE; BeltTag := BinM;
                Started := TRUE;
            END_IF;
            (* 12 store in the first free slot *)
            IF NOT Started AND BinM <> 0 AND BinMode = 3 AND NOT LvBin THEN
                n := 0;
                FOR i := 12 TO 1 BY -1 DO IF NOT ResSlot[i] AND SlotM[i] = 0 THEN n := i; END_IF; END_FOR;
                IF n <> 0 AND NOT UBusy[1] AND NOT UBusy[2] THEN
                    (* start store *)
                    UBusy[1] := TRUE; UBusy[2] := TRUE;
                    RJ[1] := 13; Seg[1] := 1; Nst[1] := Nst[1] + 1;
                    RB[1, 1] := BinM; RB[1, 2] := BinC; RB[1, 3] := n; RB[1, 4] := 0; RB[1, 5] := 0; RB[1, 6] := 0;
                    Cmd[1] := 13; Arg[1] := n;
                    LvBin := TRUE; ResSlot[n] := TRUE;
                    Started := TRUE;
                END_IF;
            END_IF;
            (* 13 fetch an empty mould for a cookie going in (with reuse: only when nothing is left to retrieve) *)
            IF NOT Started AND NOT ResBin AND BinM = 0 AND NOT ResBout AND BoutM = 0 AND tm = 0 THEN
                Pend := 0;
                FOR i := 1 TO 12 DO IF ISRET[i] AND Stage[i] = 2 THEN Pend := Pend + 1; END_IF; END_FOR;
                IF BinM <> 0 AND BinMode = 2 THEN Pend := Pend - 1; END_IF;
                IF BoutM <> 0 AND BoutMode = 2 THEN Pend := Pend - 1; END_IF;
                IF RJ[1] = 14 THEN Pend := Pend - 1; END_IF;
                IF Pend > 0 THEN
                    n := 0;
                    FOR i := 12 TO 1 BY -1 DO IF SlotM[i] <> 0 AND SlotC[i] = 0 AND NOT LvSlot[i] THEN n := i; END_IF; END_FOR;
                    IF n <> 0 AND NOT UBusy[1] AND NOT UBusy[2] THEN
                        (* start fetch_empty *)
                        UBusy[1] := TRUE; UBusy[2] := TRUE;
                        RJ[1] := 14; Seg[1] := 1; Nst[1] := Nst[1] + 1;
                        RB[1, 1] := SlotM[n]; RB[1, 2] := n; RB[1, 3] := 0; RB[1, 4] := 0; RB[1, 5] := 0; RB[1, 6] := 0;
                        Cmd[1] := 14; Arg[1] := n;
                        LvSlot[n] := TRUE; ResBin := TRUE;
                        Started := TRUE;
                    END_IF;
                END_IF;
            END_IF;
            (* 14 retrieve the next cookie in production order *)
            IF NOT Started AND NOT ResBin AND BinM = 0 AND NOT ResBout AND BoutM = 0 AND tm <> 0 THEN
                IF NOT LvSlot[ts] AND NOT UBusy[1] AND NOT UBusy[2] THEN
                    (* start retrieve *)
                    UBusy[1] := TRUE; UBusy[2] := TRUE;
                    RJ[1] := 15; Seg[1] := 1; Nst[1] := Nst[1] + 1;
                    RB[1, 1] := tm; RB[1, 2] := SlotM[ts]; RB[1, 3] := ts; RB[1, 4] := 0; RB[1, 5] := 0; RB[1, 6] := 0;
                    Cmd[1] := 15; Arg[1] := ts;
                    LvSlot[ts] := TRUE; ResBin := TRUE;
                    Started := TRUE;
                END_IF;
            END_IF;
        UNTIL NOT Started
        END_REPEAT;
    END_IF;
END_IF;

(* 3. completions, leads in unit order (control.simulate's tie order); each is followed by a dispatch *)
IF Phase = 1 THEN
    FOR k := 1 TO 8 DO
        IF RJ[k] <> 0 AND Seg[k] <> 0 THEN
            IF Dn[Seg[k]] THEN
                IF RJ[k] = 4 AND Seg[k] = 5 THEN   (* to_tt: next segment *)
                    Seg[k] := 4; Cmd[4] := 4; Arg[4] := Arg[5]; Dn[5] := FALSE;
                END_IF;
            END_IF;
            IF Dn[Seg[k]] THEN
                (* complete the job lead k runs: control.complete() *)
                jb := RJ[k]; x1 := RB[k, 1]; x2 := RB[k, 2]; x3 := RB[k, 3]; x4 := RB[k, 4]; x5 := RB[k, 5]; x6 := RB[k, 6];
                RJ[k] := 0; Seg[k] := 0; Jobs := Jobs + 1;
                CASE jb OF
                  1: (* sort *)
                      UBusy[8] := FALSE;
                      LvSin := FALSE; ResBay[x2] := ResBay[x2] - 1;
                      BayN[x2] := BayN[x2] + 1; Bay[x2, BayN[x2]] := x1; Inlet := 0; Stage[x1] := 6;
                  2: (* ovenbelt *)
                      UBusy[7] := FALSE;
                      LvOvb := FALSE; ResSin := FALSE;
                      Inlet := Ovb; Ovb := 0;
                  3: (* saw_eject *)
                      UBusy[6] := FALSE;
                      LvTt := FALSE; ResOvb := FALSE;
                      Ovb := Tt; Tt := 0; Stage[x1] := 5;
                  4: (* to_tt *)
                      UBusy[5] := FALSE; UBusy[4] := FALSE;
                      LvTray := FALSE; ResTt := FALSE;
                      Tt := Tray; Tray := 0; Tout := FALSE;
                  5: (* bake *)
                      UBusy[4] := FALSE;
                      LvTray := FALSE;
                      Stage[x1] := 5;
                  6: (* present *)
                      UBusy[4] := FALSE;
                      Tout := TRUE;
                  7: (* place_oven *)
                      UBusy[3] := FALSE; UBusy[4] := FALSE;
                      Tray := CupC; CupC := 0; CupSrc := 0;
                  8: (* belt_to_oven *)
                      UBusy[3] := FALSE; UBusy[2] := FALSE;
                      LvBout := FALSE; ResTray := FALSE;
                      Pend := 0;
                      FOR i := 1 TO 12 DO IF ISRET[i] AND Stage[i] = 2 THEN Pend := Pend + 1; END_IF; END_FOR;
                      IF BinM <> 0 AND BinMode = 2 THEN Pend := Pend - 1; END_IF;
                      IF BoutM <> 0 AND BoutMode = 2 THEN Pend := Pend - 1; END_IF;
                      IF RJ[1] = 14 THEN Pend := Pend - 1; END_IF;
                      BoutC := 0; IF Pend > 0 THEN BoutMode := 2; ELSE BoutMode := 3; END_IF;
                      CupC := x1; CupSrc := 1;
                  9: (* bay_to_belt *)
                      UBusy[3] := FALSE; UBusy[2] := FALSE;
                      LvBay[x2] := FALSE;
                      n := 0;
                      FOR j := 1 TO BayN[x2] DO IF Bay[x2, j] <> x1 THEN n := n + 1; Bay[x2, n] := Bay[x2, j]; END_IF; END_FOR;
                      FOR j := n + 1 TO BAYCAP DO Bay[x2, j] := 0; END_FOR;
                      BayN[x2] := n; BoutM := x3; BoutC := x1; BoutMode := 3; Stage[x1] := 3;
                  10: (* belt_back *)
                      UBusy[2] := FALSE;
                      LvBout := FALSE; ResBin := FALSE;
                      BinM := BoutM; BinC := BoutC; BinMode := BoutMode; BoutM := 0; BoutC := 0; BoutMode := 0;
                  11: (* store_retrieve *)
                      UBusy[1] := FALSE; UBusy[2] := FALSE;
                      LvBin := FALSE; LvSlot[x6] := FALSE; ResSlot[x3] := FALSE; ResBin := FALSE;
                      SlotM[x3] := x1; SlotC[x3] := x2; SlotM[x6] := 0; SlotC[x6] := 0;
                      IF x2 <> 0 THEN Stage[x2] := 4; END_IF;
                      BinM := x5; BinC := x4; BinMode := 1;
                  12: (* belt_fwd *)
                      UBusy[2] := FALSE;
                      LvBin := FALSE; ResBout := FALSE;
                      BoutM := BinM; BoutC := BinC; BoutMode := BinMode; BinM := 0; BinC := 0; BinMode := 0;
                  13: (* store *)
                      UBusy[1] := FALSE; UBusy[2] := FALSE;
                      LvBin := FALSE; ResSlot[x3] := FALSE;
                      SlotM[x3] := x1; SlotC[x3] := x2; BinM := 0; BinC := 0; BinMode := 0;
                      IF x2 <> 0 THEN Stage[x2] := 4; END_IF;
                  14: (* fetch_empty *)
                      UBusy[1] := FALSE; UBusy[2] := FALSE;
                      LvSlot[x2] := FALSE; ResBin := FALSE;
                      SlotM[x2] := 0; SlotC[x2] := 0; BinM := x1; BinC := 0; BinMode := 2;
                  15: (* retrieve *)
                      UBusy[1] := FALSE; UBusy[2] := FALSE;
                      LvSlot[x3] := FALSE; ResBin := FALSE;
                      SlotM[x3] := 0; SlotC[x3] := 0; BinM := x2; BinC := x1; BinMode := 1;
                END_CASE;
                REPEAT
                    Started := FALSE;
                    (* 1 sort: the cookie at the sorting inlet, if its bay has room *)
                    IF NOT Started AND Inlet <> 0 AND NOT LvSin THEN
                        b := FLV[Inlet];
                        IF BayN[b] + ResBay[b] < BAYCAP AND NOT UBusy[8] THEN
                            (* start sort *)
                            UBusy[8] := TRUE;
                            RJ[8] := 1; Seg[8] := 8; Nst[8] := Nst[8] + 1;
                            RB[8, 1] := Inlet; RB[8, 2] := b; RB[8, 3] := 0; RB[8, 4] := 0; RB[8, 5] := 0; RB[8, 6] := 0;
                            Cmd[8] := 1; Arg[8] := b;
                            LvSin := TRUE; ResBay[b] := ResBay[b] + 1;
                            Started := TRUE;
                        END_IF;
                    END_IF;
                    (* 2 oven belt -> sorting inlet *)
                    IF NOT Started AND Ovb <> 0 AND NOT LvOvb AND NOT ResSin AND Inlet = 0 AND NOT UBusy[7] THEN
                        (* start ovenbelt *)
                        UBusy[7] := TRUE;
                        RJ[7] := 2; Seg[7] := 7; Nst[7] := Nst[7] + 1;
                        RB[7, 1] := Ovb; RB[7, 2] := 0; RB[7, 3] := 0; RB[7, 4] := 0; RB[7, 5] := 0; RB[7, 6] := 0;
                        Cmd[7] := 2; Arg[7] := 1;
                        LvOvb := TRUE; ResSin := TRUE;
                        Started := TRUE;
                    END_IF;
                    (* 3 saw and eject *)
                    IF NOT Started AND Tt <> 0 AND NOT LvTt AND Stage[Tt] = 5 AND NOT ResOvb AND Ovb = 0 AND NOT UBusy[6] THEN
                        (* start saw_eject *)
                        UBusy[6] := TRUE;
                        RJ[6] := 3; Seg[6] := 6; Nst[6] := Nst[6] + 1;
                        RB[6, 1] := Tt; RB[6, 2] := 0; RB[6, 3] := 0; RB[6, 4] := 0; RB[6, 5] := 0; RB[6, 6] := 0;
                        Cmd[6] := 3; Arg[6] := 1;
                        LvTt := TRUE; ResOvb := TRUE;
                        Started := TRUE;
                    END_IF;
                    (* 4 Sauger: tray -> turntable *)
                    IF NOT Started AND Tray <> 0 AND NOT LvTray AND Stage[Tray] = 5 AND NOT ResTt AND Tt = 0 AND NOT UBusy[5] AND NOT UBusy[4] THEN
                        (* start to_tt *)
                        UBusy[5] := TRUE; UBusy[4] := TRUE;
                        RJ[5] := 4; Seg[5] := 5; Nst[5] := Nst[5] + 1;
                        RB[5, 1] := Tray; RB[5, 2] := 0; RB[5, 3] := 0; RB[5, 4] := 0; RB[5, 5] := 0; RB[5, 6] := 0;
                        Cmd[5] := 4; Arg[5] := 1;
                        LvTray := TRUE; ResTt := TRUE;
                        Started := TRUE;
                    END_IF;
                    (* 5 bake *)
                    IF NOT Started AND Tray <> 0 AND NOT LvTray AND Stage[Tray] = 1 AND NOT UBusy[4] THEN
                        (* start bake *)
                        UBusy[4] := TRUE;
                        RJ[4] := 5; Seg[4] := 4; Nst[4] := Nst[4] + 1;
                        RB[4, 1] := Tray; RB[4, 2] := 0; RB[4, 3] := 0; RB[4, 4] := 0; RB[4, 5] := 0; RB[4, 6] := 0;
                        Cmd[4] := 5; Arg[4] := 1;
                        LvTray := TRUE;
                        Started := TRUE;
                    END_IF;
                    (* 5a the oven presents its tray while the cookie for it is on its way *)
                    IF NOT Started AND Tray = 0 AND NOT Tout AND (CupC <> 0 OR ResTray) AND NOT LvTray AND NOT UBusy[4] THEN
                        (* start present *)
                        UBusy[4] := TRUE;
                        RJ[4] := 6; Seg[4] := 4; Nst[4] := Nst[4] + 1;
                        RB[4, 1] := CupC; RB[4, 2] := 0; RB[4, 3] := 0; RB[4, 4] := 0; RB[4, 5] := 0; RB[4, 6] := 0;
                        Cmd[4] := 6; Arg[4] := 1;
                        Started := TRUE;
                    END_IF;
                    (* 5b the VGR lays the cookie on the presented tray *)
                    IF NOT Started AND CupC <> 0 AND Tout AND Tray = 0 AND NOT UBusy[3] AND NOT UBusy[4] THEN
                        (* start place_oven *)
                        UBusy[3] := TRUE; UBusy[4] := TRUE;
                        RJ[3] := 7; Seg[3] := 3; Nst[3] := Nst[3] + 1;
                        RB[3, 1] := CupC; RB[3, 2] := CupSrc; RB[3, 3] := 0; RB[3, 4] := 0; RB[3, 5] := 0; RB[3, 6] := 0;
                        Cmd[3] := 7; Arg[3] := 1;
                        Started := TRUE;
                    END_IF;
                    (* 7 belt -> oven (the pick half): the oven is free of a committed cookie, the cup is empty *)
                    IF NOT Started AND BoutM <> 0 AND BoutC <> 0 AND BoutMode = 1 AND NOT LvBout AND CupC = 0 AND NOT ResTray AND NOT UBusy[3] AND NOT UBusy[2] THEN
                        (* start belt_to_oven *)
                        UBusy[3] := TRUE; UBusy[2] := TRUE;
                        RJ[3] := 8; Seg[3] := 3; Nst[3] := Nst[3] + 1;
                        RB[3, 1] := BoutC; RB[3, 2] := BoutM; RB[3, 3] := 0; RB[3, 4] := 0; RB[3, 5] := 0; RB[3, 6] := 0;
                        Cmd[3] := 8; Arg[3] := 1;
                        LvBout := TRUE; ResTray := TRUE;
                        Started := TRUE;
                    END_IF;
                    (* 9 bay -> the empty mould at the hand-over (the first bay holding a cookie that goes in) *)
                    IF NOT Started AND BoutM <> 0 AND BoutC = 0 AND BoutMode = 2 AND NOT LvBout AND CupC = 0 THEN
                        Found := FALSE;
                        FOR i := 1 TO 3 DO
                            IF NOT Found THEN
                                FOR j := 1 TO BayN[i] DO
                                    IF NOT Found AND Stage[Bay[i, j]] = 2 THEN Found := TRUE; c := Bay[i, j]; b := i; END_IF;
                                END_FOR;
                            END_IF;
                        END_FOR;
                        IF Found AND NOT UBusy[3] AND NOT UBusy[2] THEN
                            (* start bay_to_belt *)
                            UBusy[3] := TRUE; UBusy[2] := TRUE;
                            RJ[3] := 9; Seg[3] := 3; Nst[3] := Nst[3] + 1;
                            RB[3, 1] := c; RB[3, 2] := b; RB[3, 3] := BoutM; RB[3, 4] := 0; RB[3, 5] := 0; RB[3, 6] := 0;
                            Cmd[3] := 9; Arg[3] := b;
                            LvBay[b] := TRUE;
                            Started := TRUE;
                        END_IF;
                    END_IF;
                    (* 10 belt back *)
                    IF NOT Started AND BoutM <> 0 AND BoutMode = 3 AND NOT LvBout AND NOT ResBin AND BinM = 0 AND NOT UBusy[2] THEN
                        (* start belt_back *)
                        UBusy[2] := TRUE;
                        RJ[2] := 10; Seg[2] := 2; Nst[2] := Nst[2] + 1;
                        RB[2, 1] := BoutM; RB[2, 2] := BoutC; RB[2, 3] := 0; RB[2, 4] := 0; RB[2, 5] := 0; RB[2, 6] := 0;
                        Cmd[2] := 10; Arg[2] := 1;
                        LvBout := TRUE; ResBin := TRUE; BeltTag := BoutM;
                        Started := TRUE;
                    END_IF;
                    (* the next cookie of the production order that is still raw in the rack, and its slot *)
                    tm := 0; ts := 0;
                    FOR i := 1 TO 9 DO
                        IF tm = 0 AND Stage[PROD[i]] = 1 THEN
                            FOR j := 1 TO 12 DO IF SlotM[j] <> 0 AND SlotC[j] = PROD[i] THEN tm := PROD[i]; ts := j; END_IF; END_FOR;
                        END_IF;
                    END_FOR;
                    (* 10a dual command: store the mould coming in in the free slot nearest the next cookie, retrieve that cookie *)
                    IF NOT Started AND BinM <> 0 AND BinMode = 3 AND NOT LvBin AND tm <> 0 AND NOT ResBout AND BoutM = 0 THEN
                        n := 0; BestT := 1.0E9;
                        FOR i := 1 TO 12 DO
                            IF NOT ResSlot[i] AND SlotM[i] = 0 THEN
                                IF DUALT[i, ts] < BestT THEN BestT := DUALT[i, ts]; n := i; END_IF;
                            END_IF;
                        END_FOR;
                        IF n <> 0 AND NOT LvSlot[ts] AND NOT UBusy[1] AND NOT UBusy[2] THEN
                            (* start store_retrieve *)
                            UBusy[1] := TRUE; UBusy[2] := TRUE;
                            RJ[1] := 11; Seg[1] := 1; Nst[1] := Nst[1] + 1;
                            RB[1, 1] := BinM; RB[1, 2] := BinC; RB[1, 3] := n; RB[1, 4] := tm; RB[1, 5] := SlotM[ts]; RB[1, 6] := ts;
                            Cmd[1] := 11; Arg[1] := (n - 1) * 12 + ts;
                            LvBin := TRUE; LvSlot[ts] := TRUE; ResSlot[n] := TRUE; ResBin := TRUE;
                            Started := TRUE;
                        END_IF;
                    END_IF;
                    (* 11 belt forward *)
                    IF NOT Started AND BinM <> 0 AND (BinMode = 1 OR BinMode = 2) AND NOT LvBin AND NOT ResBout AND BoutM = 0 AND NOT UBusy[2] THEN
                        (* start belt_fwd *)
                        UBusy[2] := TRUE;
                        RJ[2] := 12; Seg[2] := 2; Nst[2] := Nst[2] + 1;
                        RB[2, 1] := BinM; RB[2, 2] := BinC; RB[2, 3] := 0; RB[2, 4] := 0; RB[2, 5] := 0; RB[2, 6] := 0;
                        Cmd[2] := 12; Arg[2] := 1;
                        LvBin := TRUE; ResBout := TRUE; BeltTag := BinM;
                        Started := TRUE;
                    END_IF;
                    (* 12 store in the first free slot *)
                    IF NOT Started AND BinM <> 0 AND BinMode = 3 AND NOT LvBin THEN
                        n := 0;
                        FOR i := 12 TO 1 BY -1 DO IF NOT ResSlot[i] AND SlotM[i] = 0 THEN n := i; END_IF; END_FOR;
                        IF n <> 0 AND NOT UBusy[1] AND NOT UBusy[2] THEN
                            (* start store *)
                            UBusy[1] := TRUE; UBusy[2] := TRUE;
                            RJ[1] := 13; Seg[1] := 1; Nst[1] := Nst[1] + 1;
                            RB[1, 1] := BinM; RB[1, 2] := BinC; RB[1, 3] := n; RB[1, 4] := 0; RB[1, 5] := 0; RB[1, 6] := 0;
                            Cmd[1] := 13; Arg[1] := n;
                            LvBin := TRUE; ResSlot[n] := TRUE;
                            Started := TRUE;
                        END_IF;
                    END_IF;
                    (* 13 fetch an empty mould for a cookie going in (with reuse: only when nothing is left to retrieve) *)
                    IF NOT Started AND NOT ResBin AND BinM = 0 AND NOT ResBout AND BoutM = 0 AND tm = 0 THEN
                        Pend := 0;
                        FOR i := 1 TO 12 DO IF ISRET[i] AND Stage[i] = 2 THEN Pend := Pend + 1; END_IF; END_FOR;
                        IF BinM <> 0 AND BinMode = 2 THEN Pend := Pend - 1; END_IF;
                        IF BoutM <> 0 AND BoutMode = 2 THEN Pend := Pend - 1; END_IF;
                        IF RJ[1] = 14 THEN Pend := Pend - 1; END_IF;
                        IF Pend > 0 THEN
                            n := 0;
                            FOR i := 12 TO 1 BY -1 DO IF SlotM[i] <> 0 AND SlotC[i] = 0 AND NOT LvSlot[i] THEN n := i; END_IF; END_FOR;
                            IF n <> 0 AND NOT UBusy[1] AND NOT UBusy[2] THEN
                                (* start fetch_empty *)
                                UBusy[1] := TRUE; UBusy[2] := TRUE;
                                RJ[1] := 14; Seg[1] := 1; Nst[1] := Nst[1] + 1;
                                RB[1, 1] := SlotM[n]; RB[1, 2] := n; RB[1, 3] := 0; RB[1, 4] := 0; RB[1, 5] := 0; RB[1, 6] := 0;
                                Cmd[1] := 14; Arg[1] := n;
                                LvSlot[n] := TRUE; ResBin := TRUE;
                                Started := TRUE;
                            END_IF;
                        END_IF;
                    END_IF;
                    (* 14 retrieve the next cookie in production order *)
                    IF NOT Started AND NOT ResBin AND BinM = 0 AND NOT ResBout AND BoutM = 0 AND tm <> 0 THEN
                        IF NOT LvSlot[ts] AND NOT UBusy[1] AND NOT UBusy[2] THEN
                            (* start retrieve *)
                            UBusy[1] := TRUE; UBusy[2] := TRUE;
                            RJ[1] := 15; Seg[1] := 1; Nst[1] := Nst[1] + 1;
                            RB[1, 1] := tm; RB[1, 2] := SlotM[ts]; RB[1, 3] := ts; RB[1, 4] := 0; RB[1, 5] := 0; RB[1, 6] := 0;
                            Cmd[1] := 15; Arg[1] := ts;
                            LvSlot[ts] := TRUE; ResBin := TRUE;
                            Started := TRUE;
                        END_IF;
                    END_IF;
                UNTIL NOT Started
                END_REPEAT;
            END_IF;
        END_IF;
    END_FOR;
    (* the order is complete: nothing running, nothing in transit, every cookie done or stored *)
    Found := (BinM = 0) AND (BoutM = 0) AND (Tray = 0) AND (Tt = 0) AND (Ovb = 0) AND (Inlet = 0) AND (CupC = 0);
    FOR k := 1 TO 8 DO Found := Found AND (RJ[k] = 0); END_FOR;
    FOR k := 1 TO 9 DO Found := Found AND (Stage[PROD[k]] = 6); END_FOR;
    IF Found THEN Phase := 2; END_IF;
END_IF;

(* 4. the monitor *)
mon_phase := Phase; mon_jobs := Jobs;
mon_crane_sn := Crane.Sn; mon_crane_job := RJ[1]; mon_crane_alarm := Crane.Alarm; mon_crane_seg := Seg[1]; mon_crane_n := Nst[1];
mon_crane_b1 := RB[1, 1]; mon_crane_b2 := RB[1, 2]; mon_crane_b3 := RB[1, 3]; mon_crane_b4 := RB[1, 4]; mon_crane_b5 := RB[1, 5]; mon_crane_b6 := RB[1, 6];
mon_belt_sn := Belt.Sn; mon_belt_job := RJ[2]; mon_belt_alarm := Belt.Alarm; mon_belt_seg := Seg[2]; mon_belt_n := Nst[2];
mon_belt_b1 := RB[2, 1]; mon_belt_b2 := RB[2, 2]; mon_belt_b3 := RB[2, 3]; mon_belt_b4 := RB[2, 4]; mon_belt_b5 := RB[2, 5]; mon_belt_b6 := RB[2, 6];
mon_arm_sn := Arm.Sn; mon_arm_job := RJ[3]; mon_arm_alarm := Arm.Alarm; mon_arm_seg := Seg[3]; mon_arm_n := Nst[3];
mon_arm_b1 := RB[3, 1]; mon_arm_b2 := RB[3, 2]; mon_arm_b3 := RB[3, 3]; mon_arm_b4 := RB[3, 4]; mon_arm_b5 := RB[3, 5]; mon_arm_b6 := RB[3, 6];
mon_door_sn := Door.Sn; mon_door_job := RJ[4]; mon_door_alarm := Door.Alarm; mon_door_seg := Seg[4]; mon_door_n := Nst[4];
mon_door_b1 := RB[4, 1]; mon_door_b2 := RB[4, 2]; mon_door_b3 := RB[4, 3]; mon_door_b4 := RB[4, 4]; mon_door_b5 := RB[4, 5]; mon_door_b6 := RB[4, 6];
mon_sauger_sn := Sauger.Sn; mon_sauger_job := RJ[5]; mon_sauger_alarm := Sauger.Alarm; mon_sauger_seg := Seg[5]; mon_sauger_n := Nst[5];
mon_sauger_b1 := RB[5, 1]; mon_sauger_b2 := RB[5, 2]; mon_sauger_b3 := RB[5, 3]; mon_sauger_b4 := RB[5, 4]; mon_sauger_b5 := RB[5, 5]; mon_sauger_b6 := RB[5, 6];
mon_turntable_sn := Turntable.Sn; mon_turntable_job := RJ[6]; mon_turntable_alarm := Turntable.Alarm; mon_turntable_seg := Seg[6]; mon_turntable_n := Nst[6];
mon_turntable_b1 := RB[6, 1]; mon_turntable_b2 := RB[6, 2]; mon_turntable_b3 := RB[6, 3]; mon_turntable_b4 := RB[6, 4]; mon_turntable_b5 := RB[6, 5]; mon_turntable_b6 := RB[6, 6];
mon_ovenbelt_sn := Ovenbelt.Sn; mon_ovenbelt_job := RJ[7]; mon_ovenbelt_alarm := Ovenbelt.Alarm; mon_ovenbelt_seg := Seg[7]; mon_ovenbelt_n := Nst[7];
mon_ovenbelt_b1 := RB[7, 1]; mon_ovenbelt_b2 := RB[7, 2]; mon_ovenbelt_b3 := RB[7, 3]; mon_ovenbelt_b4 := RB[7, 4]; mon_ovenbelt_b5 := RB[7, 5]; mon_ovenbelt_b6 := RB[7, 6];
mon_line_sn := Line.Sn; mon_line_job := RJ[8]; mon_line_alarm := Line.Alarm; mon_line_seg := Seg[8]; mon_line_n := Nst[8];
mon_line_b1 := RB[8, 1]; mon_line_b2 := RB[8, 2]; mon_line_b3 := RB[8, 3]; mon_line_b4 := RB[8, 4]; mon_line_b5 := RB[8, 5]; mon_line_b6 := RB[8, 6];
END_PROGRAM

