    elementType: text
    bounds: [84, 528, 307, 34]
    content:
      style: "$label"
      fontSize: 24
      wrap: false
      align: [left, middle]
      text: STF Cell
  - elementId: a-desc
    elementType: text
    bounds: [84, 572, 307, 120]
    content:
      style: "$note"
      align: [left, top]
      text: "The machine itself — a smooth isometric enclosure with an aluminum frame, amber axes, one warm cookie inside, and its dotted twin behind."
  - elementId: a-file
    elementType: text
    bounds: [84, 824, 307, 20]
    content: {style: "$note", fontSize: 12, color: "$faint", wrap: false, align: [left, middle], text: "design/logo/stf-cell.svg"}
