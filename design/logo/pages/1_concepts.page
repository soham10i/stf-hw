pageType: content
background:
  type: solid
  color: "$bg"
elements:
  # ---------- header ----------
  - elementId: title
    elementType: text
    bounds: [60, 52, 1000, 48]
    content:
      fontFamily: Liter
      fontSize: 36
      color: "$text"
      wrap: false
      align: [left, middle]
      text: |
        <p><strong>STF Digital Twin</strong> <span style="color:$muted; font-size:24px;">— logo concepts, refined</span></p>
  - elementId: subtitle
    elementType: text
    bounds: [60, 106, 1200, 22]
    content:
      style: "$note"
      wrap: false
      align: [left, middle]
      text: "smooth strokes · colors sampled from the live twin and console — amber #E8A33D · UI blue #1E7BEE · machine coral #EE7B62 · aluminum #B9C0C9"
  # ---------- card 01 : STF Cell ----------
  - elementId: cardA
    elementType: shape
    bounds: [60, 210, 355, 660]
    shapeName: roundRect
    adjustments: [4000]
    fill: {type: solid, color: "$surface"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: cardA-bar
    elementType: shape
    bounds: [60, 210, 355, 3]
    shapeName: rect
    fill: {type: solid, color: "$amber"}
  - elementId: cardA-num
