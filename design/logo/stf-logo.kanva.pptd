version: v2
title: STF Digital Twin — Logo Concepts v2
size: [1600, 1000]
customFonts:
  - family: Liter
    src: "https://statics.kimi.ai/neo-design-static/p-font/Liter.ttf"
  - family: JetBrains Mono
    src: "https://fonts.googleapis.com/css2?family=JetBrains Mono"
theme:
  colors:
    bg: "#0A0C0F"
    surface: "#0E1218"
    raised: "#131820"
    tile: "#0C0E11"
    line: "#FFFFFF14"
    text: "#E9EBEE"
    muted: "#8B929D"
    faint: "#5A616C"
    amber: "#E8A33D"
    amberHi: "#F2B45A"
    amberLo: "#D98E2B"
    doughHi: "#F6C878"
    doughLo: "#E09A2F"
    blue: "#1E7BEE"
    blueHi: "#4EA3FF"
    blueLo: "#0E6CDE"
    coral: "#EE7B62"
    alu: "#B9C0C9"
    aluLo: "#7E8A96"
    cream: "#F7E9CF"
  textStyles:
    label:
      fontSize: 22
      color: "$text"
      fontFamily: Liter
    note:
      fontSize: 13
      color: "$muted"
      fontFamily: JetBrains Mono
      lineHeight: 1.5
pages:
  - pages/1_concepts.page
  - pages/2_context.page
