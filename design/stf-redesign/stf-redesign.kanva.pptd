version: v2
title: STF Twin — Operations Console Redesign
size: [1600, 1000]
customFonts:
  - family: Liter
    src: "https://statics.kimi.ai/neo-design-static/p-font/Liter.ttf"
  - family: JetBrains Mono
    src: "https://fonts.googleapis.com/css2?family=JetBrains+Mono"
theme:
  colors:
    bg: "#0A0C0F"
    rail: "#0C0F13"
    surface: "#0E1218"
    raised: "#131820"
    line: "#FFFFFF14"
    lineSoft: "#FFFFFF0A"
    text: "#E9EBEE"
    muted: "#8B929D"
    faint: "#5A616C"
    accent: "#E8A33D"
    ok: "#45A877"
    warn: "#E2622B"
    fail: "#D64550"
  textStyles:
    mono:
      fontSize: 12
      color: "$text"
      fontFamily: "JetBrains Mono"
pages:
  - pages/1_overview.page
  - pages/2_health.page
